{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "Environment": "Production",
    "AppName": "ERP SaaS",
    "Version": "1.0.0",
    "Description": "Sistema ERP SaaS Multiempresa",
    "AppUrl": "https://api.erpsaas.com.br",
    "ApiUrl": "https://api.erpsaas.com.br/api",
    "FrontendUrl": "https://app.erpsaas.com.br",
    "EnableSwagger": false,
    "EnableSwaggerUi": false,
    "Jwt": {
      "Secret": "ERPSaaS_Production_SuperSecretKey_2024_ChangeThisInProduction",
      "Issuer": "ERP SaaS",
      "Audience": "ERP SaaS API",
      "ExpiryMinutes": 60,
      "RefreshTokenExpiryDays": 30,
      "AllowRefreshToken": true,
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateSignature": true
    },
    "TwoFactor": {
      "Issuer": "ERP SaaS",
      "CodeExpirySeconds": 30,
      "RecoveryCodesCount": 10,
      "RecoveryCodeLength": 8,
      "EnableTwoFactor": true,
      "RequireTwoFactorForAdmins": true
    },
    "Security": {
      "LockoutMinutes": 30,
      "MaxFailedAccessAttempts": 5,
      "AllowAccountLockout": true,
      "RequireStrongPassword": true,
      "MinimumPasswordLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueChars": 1
    },
    "Session": {
      "SessionExpiryMinutes": 120,
      "AllowPersistentSession": true,
      "PersistentSessionExpiryDays": 30,
      "MaxSessionsPerUser": 5
    },
    "RateLimiting": {
      "EnableRateLimiting": true,
      "RequestsPerMinute": 100,
      "RequestsPerHour": 1000,
      "RequestsPerDay": 10000,
      "BlockDurationMinutes": 15
    },
    "Cors": {
      "AllowedOrigins": [
        "https://app.erpsaas.com.br",
        "https://admin.erpsaas.com.br"
      ],
      "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "AllowedHeaders": ["*"],
      "AllowCredentials": true,
      "PreflightCacheDurationSeconds": 1800
    },
    "Database": {
      "Provider": "PostgreSQL",
      "MasterConnectionString": "Host=db.erpsaas.com.br;Port=5432;Database=erp_master;Username=erp_user;Password=erp_password",
      "TenantDatabasePrefix": "erp_tenant_",
      "TimeoutSeconds": 30,
      "MaxPoolSize": 200,
      "MinPoolSize": 10,
      "EnableSensitiveDataLogging": false,
      "EnableDetailedErrors": false,
      "EnableAutomaticMigrations": false
    },
    "Logging": {
      "MinimumLogLevel": "Warning",
      "MicrosoftLogLevel": "Warning",
      "EnableConsoleLogging": true,
      "EnableFileLogging": true,
      "FileLogPath": "/var/log/erp",
      "FileLogName": "erpsaas-",
      "FileLogMaxSizeMb": 100,
      "FileLogMaxFiles": 30,
      "EnableSeqLogging": true,
      "SeqUrl": "http://seq.erpsaas.com.br",
      "SeqApiKey": "your-seq-api-key"
    },
    "Cache": {
      "Provider": "Redis",
      "RedisConnectionString": "redis.erpsaas.com.br:6379,password=redis_password,ssl=False",
      "DefaultExpiryMinutes": 30,
      "MaxCacheSizeMb": 500,
      "EnableDistributedCache": true
    },
    "MultiTenancy": {
      "Strategy": "DatabasePerTenant",
      "TenantHeader": "X-Tenant-Id",
      "TenantSubdomainHeader": "X-Tenant-Subdomain",
      "UseSubdomain": true,
      "BaseDomain": "erpsaas.com.br",
      "AllowDefaultTenant": false,
      "DefaultTenantId": null,
      "ValidateTenantIsolation": true
    }
  }
}
