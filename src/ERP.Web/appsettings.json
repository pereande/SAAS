{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "Environment": "Development",
    "AppName": "ERP SaaS",
    "Version": "1.0.0",
    "Description": "Sistema ERP SaaS Multiempresa",
    "AppUrl": "https://localhost:5000",
    "ApiUrl": "https://localhost:5000/api",
    "FrontendUrl": "https://localhost:3000",
    "EnableSwagger": true,
    "EnableSwaggerUi": true,
    "SwaggerPath": "/swagger",
    "SwaggerTitle": "ERP SaaS API",
    "SwaggerVersion": "v1",
    "SwaggerDescription": "API do Sistema ERP SaaS Multiempresa",
    "SwaggerContact": {
      "Name": "Suporte ERP SaaS",
      "Email": "suporte@erpsaas.com.br",
      "Url": "https://erpsaas.com.br"
    },
    "SwaggerLicense": {
      "Name": "MIT License",
      "Url": "https://opensource.org/licenses/MIT"
    },
    "Jwt": {
      "Secret": "ERPSaaS_SuperSecretKey_2024_ChangeInProduction_1234567890",
      "Issuer": "ERP SaaS",
      "Audience": "ERP SaaS API",
      "ExpiryMinutes": 60,
      "RefreshTokenExpiryDays": 30,
      "AllowRefreshToken": true,
      "ValidateIssuer": true,
      "ValidateAudience": true,
      "ValidateLifetime": true,
      "ValidateSignature": true
    },
    "TwoFactor": {
      "Issuer": "ERP SaaS",
      "CodeExpirySeconds": 30,
      "RecoveryCodesCount": 10,
      "RecoveryCodeLength": 8,
      "EnableTwoFactor": true,
      "RequireTwoFactorForAdmins": true
    },
    "Security": {
      "LockoutMinutes": 30,
      "MaxFailedAccessAttempts": 5,
      "AllowAccountLockout": true,
      "RequireStrongPassword": true,
      "MinimumPasswordLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueChars": 1
    },
    "Session": {
      "SessionExpiryMinutes": 120,
      "AllowPersistentSession": true,
      "PersistentSessionExpiryDays": 30,
      "MaxSessionsPerUser": 5
    },
    "RateLimiting": {
      "EnableRateLimiting": true,
      "RequestsPerMinute": 100,
      "RequestsPerHour": 1000,
      "RequestsPerDay": 10000,
      "BlockDurationMinutes": 15
    },
    "Cors": {
      "AllowedOrigins": [
        "https://localhost:3000",
        "https://localhost:5000",
        "http://localhost:3000",
        "http://localhost:5000"
      ],
      "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
      "AllowedHeaders": ["*"],
      "AllowCredentials": true,
      "PreflightCacheDurationSeconds": 1800
    },
    "Database": {
      "Provider": "PostgreSQL",
      "MasterConnectionString": "Host=localhost;Port=5432;Database=erp_master;Username=postgres;Password=postgres",
      "TenantDatabasePrefix": "erp_tenant_",
      "TimeoutSeconds": 30,
      "MaxPoolSize": 100,
      "MinPoolSize": 0,
      "EnableSensitiveDataLogging": false,
      "EnableDetailedErrors": false,
      "EnableAutomaticMigrations": false
    },
    "Logging": {
      "MinimumLogLevel": "Information",
      "MicrosoftLogLevel": "Warning",
      "EnableConsoleLogging": true,
      "EnableFileLogging": true,
      "FileLogPath": "Logs",
      "FileLogName": "erpsaas-",
      "FileLogMaxSizeMb": 100,
      "FileLogMaxFiles": 30,
      "EnableSeqLogging": false,
      "SeqUrl": "http://localhost:5341",
      "SeqApiKey": ""
    },
    "Cache": {
      "Provider": "Memory",
      "RedisConnectionString": "",
      "DefaultExpiryMinutes": 30,
      "MaxCacheSizeMb": 100,
      "EnableDistributedCache": false
    },
    "MultiTenancy": {
      "Strategy": "DatabasePerTenant",
      "TenantHeader": "X-Tenant-Id",
      "TenantSubdomainHeader": "X-Tenant-Subdomain",
      "UseSubdomain": false,
      "BaseDomain": "erpsaas.com.br",
      "AllowDefaultTenant": true,
      "DefaultTenantId": null,
      "ValidateTenantIsolation": true
    }
  }
}
