# Nunca coloque valores reais neste arquivo.
# Local: use dotnet user-secrets set no projeto src/ERP.Web.
# Railway: cadastre estas variáveis no serviço da API.

AppSettings__Database__MasterConnectionString=Host=SEU_HOST;Port=5432;Database=postgres;Username=SEU_USUARIO;Password=SUA_SENHA;SSL Mode=Require;Trust Server Certificate=true
AppSettings__Jwt__Secret=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
AppSettings__Jwt__Issuer=erp-saas
AppSettings__Jwt__Audience=erp-saas-client
AppSettings__Cors__AllowedOrigins__0=https://SEU-FRONTEND.up.railway.app
AppSettings__MultiTenancy__Strategy=SharedDatabase
AppSettings__MultiTenancy__TenantHeader=X-Tenant-Id
AppSettings__MultiTenancy__AllowDefaultTenant=false
